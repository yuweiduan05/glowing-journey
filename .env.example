# ============================================================
# 统一环境变量模板（复制为 .env 后填写；真实 Key 禁止提交）
# ============================================================

# ---------- 端口 ----------
GATEWAY_PORT=8081
BUSINESS_API_PORT=8082
RAG_PORT=8083

# ---------- 服务地址（网关访问下游）----------
BUSINESS_API_BASE_URL=http://127.0.0.1:8082
RAG_BASE_URL=http://127.0.0.1:8083
RAG_TIMEOUT_MS=8000
TOOL_TIMEOUT_MS=5000

# ---------- 模型接入 ----------
# mock  : 确定性假回复 + 规则化 tool_calls（离线可用，默认）
# openai: 任何 OpenAI 兼容供应商（OpenAI / DeepSeek / 通义 / Kimi / Ollama 等）
# 改完可用 `pnpm drill:model` 验证真实调用；加 `-- --gateway` 再验端到端
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_MS=30000

# proxy 链路的备用供应商（MODEL_PROVIDER=openai 时生效，可留空）
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_BASE_URL=
MODEL_FALLBACK_NAME=

# ---------- 网关链路容灾 ----------
# direct: 单次调用，不重试不降级（协议透传，最接近"网关不改变行为"）
# proxy : 429/5xx 重试 + 备用供应商降级 + 熔断
PROXY_MAX_RETRIES=2
PROXY_RETRY_BASE_MS=300
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=15000

# ---------- 鉴权（演示用固定 token -> customer_id 映射）----------
# 格式: token:customer_id,token2:customer_id2
AUTH_TOKENS=demo-token:C-10087,demo-token-2:C-10099

# ---------- business-api ----------
BUSINESS_DB_PATH=./data/business.db
BUSINESS_SEED=1
# 故障注入总开关：默认关（安全默认）；演示 / e2e 需要 ?chaos= 时由 dev profile 显式开
BUSINESS_CHAOS_ENABLED=0
# 写工具限流：单客户 N 单 / 窗口毫秒
TICKET_RATE_LIMIT=5
TICKET_RATE_WINDOW_MS=60000

# ---------- 网关 ----------
# SSE 心跳间隔（毫秒），过小增加空转，过大容易被中间层掐断
SSE_HEARTBEAT_MS=15000

# ---------- RAG ----------
# 向量库：chroma（默认，需安装 chromadb）/ local（零依赖 JSONL 兜底）
VECTOR_STORE=chroma
CHROMA_DIR=./data/chroma
KB_DIR=./data/kb
MANIFEST_PATH=./data/manifest.json
RAG_LOAD_EXISTING=1
# 切块参数（场景2 明示：800 / 120）
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 表格每块包含的数据行数（切块时重复表头）
TABLE_ROW_GROUP=8
# 检索参数
RETRIEVE_TOP_K=8
FILTER_THRESHOLD=0.35
FINAL_TOP_K=4
RERANK_ENABLED=0
# 重试上限（状态图条件边）
MAX_RETRY=2
# embedding：hash（离线确定性）/ openai（兼容 API）
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=512
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# 生成：mock / openai（mock 时为抽取式答案，便于离线评测与演示）
RAG_LLM_PROVIDER=mock
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_MODEL=gpt-4o-mini

# ---------- 以下为代码读取但此前漏配的变量 ----------
# Python 解释器路径（.pylibs 锁定 cp313；用其他版本 Python 时指向 3.13 解释器）
RAG_PYTHON=
# 日志级别（gateway / business-api 的 fastify logger）
LOG_LEVEL=info
# RAG 服务监听地址（默认 127.0.0.1，仅本机）
RAG_HOST=127.0.0.1
# RAG 调用上游 LLM 的超时（秒）
RAG_LLM_TIMEOUT_S=30
# 前端访问网关的地址（Vite 构建时内联；Docker web 构建传空走同源反代）
VITE_GATEWAY_URL=
# e2e 脚本使用的网关基地址
GATEWAY_BASE=http://127.0.0.1:8081
