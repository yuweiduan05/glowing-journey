# 共享构建阶段：一次装依赖，三个 Node 服务复用
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@12.3.4 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY services/business-api/package.json services/business-api/
COPY apps/gateway/package.json apps/gateway/
RUN pnpm install --filter @app/shared --filter @app/business-api --filter @app/gateway --frozen-lockfile

COPY packages/shared packages/shared
COPY services/business-api services/business-api
COPY apps/gateway apps/gateway
RUN pnpm --filter @app/shared build \
 && pnpm --filter @app/business-api build \
 && pnpm --filter @app/gateway build

# ---------- business-api ----------
FROM node:22-bookworm-slim AS business-api
ENV NODE_ENV=production
WORKDIR /app
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/packages/shared/dist ./packages/shared/dist
COPY --from=base /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=base /app/services/business-api/dist ./services/business-api/dist
COPY --from=base /app/services/business-api/package.json ./services/business-api/package.json
COPY --from=base /app/services/business-api/node_modules ./services/business-api/node_modules
WORKDIR /app/services/business-api
ENV BUSINESS_DB_PATH=/data/business.db
EXPOSE 8082
CMD ["node", "dist/server.js"]

# ---------- gateway ----------
FROM node:22-bookworm-slim AS gateway
ENV NODE_ENV=production
WORKDIR /app
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/packages/shared/dist ./packages/shared/dist
COPY --from=base /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=base /app/apps/gateway/dist ./apps/gateway/dist
COPY --from=base /app/apps/gateway/package.json ./apps/gateway/package.json
COPY --from=base /app/apps/gateway/node_modules ./apps/gateway/node_modules
WORKDIR /app/apps/gateway
EXPOSE 8081
CMD ["node", "dist/server.js"]
