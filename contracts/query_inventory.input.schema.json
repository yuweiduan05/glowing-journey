{
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "pattern": "^SKU-[A-Z0-9]{6}$"
    },
    "warehouse_code": {
      "type": "string",
      "enum": [
        "WH-SZ",
        "WH-GZ",
        "WH-SH"
      ]
    },
    "include_reserved": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "sku"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
