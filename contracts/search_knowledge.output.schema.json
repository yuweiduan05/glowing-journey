{
  "type": "object",
  "properties": {
    "answer": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "doc_title": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "chunk_id": {
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "doc_title",
          "section",
          "chunk_id",
          "score"
        ],
        "additionalProperties": false
      }
    },
    "boundary": {
      "type": "string",
      "enum": [
        "in_kb",
        "insufficient",
        "out_of_scope"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "answer",
    "sources",
    "boundary",
    "confidence"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
