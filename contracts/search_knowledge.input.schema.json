      "minLength": 3,
      "maxLength": 500
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 4
    },
    "filters": {
      "type": "object",
      "properties": {
        "doc_type": {
          "type": "string",
          "enum": [
            "product_manual",
            "faq",
            "policy",
            "wiki"
          ]
        },
        "product_line": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
